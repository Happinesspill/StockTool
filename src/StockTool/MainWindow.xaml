<Window x:Class="StockTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StockTool.Controls"
        xmlns:conv="clr-namespace:StockTool.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="{Binding Topmost}"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Title="盯盘"
        Height="{Binding WindowHeight}"
        Width="{Binding WindowWidth}"
        MinHeight="300"
        MinWidth="320"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <conv:NegativeToBooleanConverter x:Key="NegativeConverter" />
        <conv:FontSizeConverter x:Key="FontSizeConverter" />
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        <conv:OpacityToBrushConverter x:Key="OpacityToBrushConverter" />
        <conv:NotNullToVisibleConverter x:Key="NotNullConverter" />
        <conv:EqualsToVisibilityConverter x:Key="EqualsVisConverter" />
        <conv:DoubleOffsetConverter x:Key="DoubleOffsetConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="PeriodTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15CCCCCC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Context Menu Styles -->
        <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FDFFFFFF" />
            <Setter Property="BorderBrush" Value="#E7ECF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#4F5D72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.13"
                                                  Color="#26354A" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Border Padding="12,9,12,8" Name="HeaderBorder">
                                    <StackPanel>
                                        <TextBlock x:Name="HeaderNameText"
                                                   Foreground="#27364A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="HeaderMetaText"
                                                   Foreground="#8FA0B6"
                                                   FontSize="10.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Height="1"
                                        Background="#F0F3F7"
                                        Margin="8,0" />
                                <ItemsPresenter Margin="0,5,0,1" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4F5D72" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="7,0,16,0" />
            <Setter Property="MinWidth" Value="168" />
        </Style>

        <Style x:Key="ContextMenuDeleteItemStyle" TargetType="MenuItem"
               BasedOn="{StaticResource ContextMenuItemStyle}">
            <Setter Property="Foreground" Value="#FF4262" />
        </Style>

        <Style x:Key="ListHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9AA6B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="Foreground" Value="#65758B" />
            <Setter Property="BorderBrush" Value="#E3E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{Binding Opacity, Converter={StaticResource OpacityToBrushConverter}}"
            BorderBrush="{Binding Opacity, Converter={StaticResource OpacityToBrushConverter}, ConverterParameter=CCCCCC}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#33FFFFFF"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="盯盘"
                               Foreground="#555555"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                        <Button Content="🔍"
                                Style="{StaticResource TitleBarButtonStyle}"
                                FontSize="13"
                                ToolTip="添加自选"
                                Click="BtnAdd_Click" />
                        <Button Content="⚙"
                                Style="{StaticResource TitleBarButtonStyle}"
                                FontSize="13"
                                ToolTip="设置"
                                Click="BtnSettings_Click" />
                        <Button Content="-"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="隐藏到托盘"
                                Click="BtnHide_Click" />
                        <Button Content="x"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="退出"
                                Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: Indices + Groups + List -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Indices -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Indices}"
                              Margin="6,6,6,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Margin="2,4">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#888888"
                                           FontSize="11"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Price, StringFormat={}{0:F2}}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D93025" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D93025" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Change, StringFormat={}{0:+0.00;-0.00;0.00}, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding ChangePercent, StringFormat={}{0:+0.00;-0.00;0.00}%, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Group tabs -->
                <Grid Grid.Row="1" Margin="8,4,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Groups}"
                             SelectedValue="{Binding SelectedGroupId, Mode=TwoWay}"
                             SelectedValuePath="Id"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="2,4" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <StackPanel Background="Transparent">
                                                <TextBlock x:Name="TabText"
                                                           Text="{Binding Name}"
                                                           FontSize="13"
                                                           Foreground="#888888" />
                                                <Border x:Name="Underline"
                                                        Height="2"
                                                        Margin="0,3,0,0"
                                                        Background="#D93025"
                                                        CornerRadius="1"
                                                        Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#1A1A1A" />
                                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="+"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="28" Height="28"
                                FontSize="16"
                                ToolTip="新建分组"
                                Click="BtnAddGroup_Click" />
                        <Button Content="✎"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="28" Height="28"
                                FontSize="13"
                                ToolTip="管理分组"
                                Click="BtnManageGroups_Click" />
                        <Button Content="{Binding EditModeText}"
                                Style="{StaticResource EditPillButtonStyle}"
                                ToolTip="编辑列表"
                                Click="BtnEditMode_Click" />
                    </StackPanel>
                </Grid>

                <!-- Holding summary -->
                <Border Grid.Row="2" Margin="10,6,12,3" Background="#F6F8FB" BorderBrush="#E9EDF3" BorderThickness="1" CornerRadius="7" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="持仓市值" Foreground="#9AA6B8" FontSize="10"/><TextBlock Text="{Binding HoldingMarketValueText}" Foreground="#4F5D72" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="总浮盈" Foreground="#9AA6B8" FontSize="10"/><TextBlock Text="{Binding HoldingProfitTotalText}" Foreground="#D93025" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="今日盈亏" Foreground="#9AA6B8" FontSize="10"/><TextBlock Text="{Binding HoldingTodayProfitText}" Foreground="#D93025" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                        <Button Grid.Column="3" Content="◉" Style="{StaticResource TitleBarButtonStyle}" ToolTip="预警设置" Click="BtnAlertSettings_Click" />
                    </Grid>
                </Border>

                <!-- Column header -->
                <ScrollViewer x:Name="HeaderScroll"
                              Grid.Row="3"
                              Height="22"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,4,0,2">
                    <Grid MinWidth="320" Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称"
                                   Foreground="#9AA6B8"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Tag="change"
                                Style="{StaticResource ListHeaderButtonStyle}"
                                HorizontalContentAlignment="Right"
                                Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="现价/涨幅" />
                                <TextBlock Text="{Binding ChangeSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Text="趋势" Foreground="#9AA6B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Tag="profit" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="持仓盈亏" />
                                <TextBlock Text="{Binding ProfitSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Visibility="Collapsed" Grid.Column="3" Text="趋势" Foreground="#9AA6B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Visibility="Collapsed" Grid.Column="4" Tag="turnover" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="成交额" />
                                <TextBlock Text="{Binding TurnoverSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" Grid.Column="5" Tag="turnoverRate" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="换手率" />
                                <TextBlock Text="{Binding TurnoverRateSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" Grid.Column="6" Tag="speed" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="涨速" />
                                <TextBlock Text="{Binding SpeedSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" Grid.Column="7" Tag="volumeRatio" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="量比" />
                                <TextBlock Text="{Binding VolumeRatioSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" Grid.Column="8" Tag="marketValue" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="流通/总市值" />
                                <TextBlock Text="{Binding MarketValueSortArrow}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>
                        <!--<Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#E8EDF3" IsHitTestVisible="False" />
                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="#E8EDF3" IsHitTestVisible="False" />
                        <Border Grid.Column="2" Width="1" HorizontalAlignment="Right" Background="#E8EDF3" IsHitTestVisible="False" />-->
                    </Grid>
                </ScrollViewer>

                <!-- Stock list -->
                <Grid Grid.Row="4">
                    <ScrollViewer x:Name="ListScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="ListScroll_ScrollChanged">
                        <ItemsControl x:Name="StockList"
                                      ItemsSource="{Binding VisibleStocks}"
                                      MinWidth="320"
                                      AllowDrop="True"
                                      PreviewMouseLeftButtonDown="StockList_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="StockList_PreviewMouseMove"
                                      Drop="StockList_Drop"
                                      GiveFeedback="StockList_GiveFeedback"
                                      DragOver="StockList_DragOver">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="52"
                                        BorderBrush="#10000000"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="StockItem_Click">
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource ContextMenuStyle}"
                                                     Opened="ContextMenu_Opened">
                                            <MenuItem Header="置顶"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_MoveTop">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M8,13.5 L8,4.5 M4.8,7.7 L8,4.5 L11.2,7.7 M4,14.5 L12,14.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="置底"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_MoveBottom">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M8,2.5 L8,11.5 M4.8,8.3 L8,11.5 L11.2,8.3 M4,1.5 L12,1.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="设置持仓"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_SetHolding">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M3,5.5 L13,5.5 A1.5,1.5 0 0 1 14.5,7 L14.5,12 A1.5,1.5 0 0 1 13,13.5 L3,13.5 A1.5,1.5 0 0 1 1.5,12 L1.5,4 A1.5,1.5 0 0 1 3,2.5 L10.5,2.5 A1.5,1.5 0 0 1 12,4 L12,5.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            <Path Data="M11.2,9.5 L14.5,9.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                            <Ellipse Canvas.Left="10.3"
                                                                     Canvas.Top="8.65"
                                                                     Width="1.7"
                                                                     Height="1.7"
                                                                     Fill="#65758B" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="删除股票"
                                                      Style="{StaticResource ContextMenuDeleteItemStyle}"
                                                      Click="ContextMenu_Delete">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M3.5,4.5 L12.5,4.5 M6.5,2.5 L9.5,2.5 M5,4.5 L5.7,13.3 A1.2,1.2 0 0 0 6.9,14.5 L9.1,14.5 A1.2,1.2 0 0 0 10.3,13.3 L11,4.5 M6.8,7 L6.8,12 M9.2,7 L9.2,12"
                                                                  Stroke="#FF4262"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="设置预警"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_SetAlert">
                                                <MenuItem.Icon><TextBlock Text="◉" Foreground="#65758B" FontSize="16" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Margin="8,4" />
                                            <MenuItem Header="从当前分组移出"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_RemoveFromGroup">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M2,5 A1.5,1.5 0 0 1 3.5,3.5 L6.3,3.5 L7.8,5 L12.5,5 A1.5,1.5 0 0 1 14,6.5 L14,12.5 A1.5,1.5 0 0 1 12.5,14 L3.5,14 A1.5,1.5 0 0 1 2,12.5 Z"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            <Path Data="M6.5,9.5 L11.5,9.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="GroupSubMenu"
                                                      Header="加入其他分组"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M2,5 A1.5,1.5 0 0 1 3.5,3.5 L6.3,3.5 L7.8,5 L12.5,5 A1.5,1.5 0 0 1 14,6.5 L14,12.5 A1.5,1.5 0 0 1 12.5,14 L3.5,14 A1.5,1.5 0 0 1 2,12.5 Z"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            <Path Data="M8,9.5 L12,9.5 M10,7.5 L10,11.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="0" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="#1A1A1A"
                                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}}"
                                                       FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border CornerRadius="3"
                                                        Background="#3050A0FF"
                                                        Padding="3,1"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ShowMarketTag, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{Binding Market}"
                                                               Foreground="#80D0FF"
                                                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=-5}" />
                                                </Border>
                                                <TextBlock Text="{Binding CodeNumeric}"
                                                           Foreground="#888888"
                                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=-3}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0">
                                            <TextBlock Text="{Binding CurrentPrice, StringFormat={}{0:F2}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#1A1A1A" />
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#D93025" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                                         Value="True">
                                                                <Setter Property="Foreground" Value="#1A8C3F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                                <Setter Property="Foreground" Value="#888888" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding ChangePercent, StringFormat={}{0:+0.00;-0.00;0.00}}" />
                                                <Run Text="%" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0">
                                            <TextBlock Text="{Binding HoldingProfit, StringFormat={}{0:+0.##;-0.##;0}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#AAB4C3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasHolding}" Value="True">
                                                                <Setter Property="Foreground" Value="#D93025" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HoldingProfit, Converter={StaticResource NegativeConverter}}" Value="True">
                                                                <Setter Property="Foreground" Value="#1A8C3F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding HoldingProfitPercent, StringFormat={}{0:+0.00;-0.00;0.00}%}"
                                                       Foreground="#8FA0B6"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <controls:SparklineControl Grid.Column="2"
                                                                    Points="{Binding IntradayPoints}"
                                                                    BaseLine="{Binding YesterdayClose}"
                                                                    IsUp="{Binding IsUp}"
                                                                    Margin="4,4" />

                                        <!--<Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#E8EDF3" IsHitTestVisible="False" />
                                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="#E8EDF3" IsHitTestVisible="False" />
                                        <Border Grid.Column="2" Width="1" HorizontalAlignment="Right" Background="#E8EDF3" IsHitTestVisible="False" />-->

                                        <TextBlock Grid.Column="4" Text="{Binding TurnoverText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding TurnoverRateText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="6" Text="{Binding SpeedText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#AAB4C3" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=Speed, Converter={StaticResource NegativeConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="#1A8C3F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Speed}" Value="0">
                                                            <Setter Property="Foreground" Value="#AAB4C3" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSpeedUp}" Value="True">
                                                            <Setter Property="Foreground" Value="#D93025" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="7" Text="{Binding VolumeRatioText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding FloatMarketValueText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding TotalMarketValueText}" Foreground="#9AA6B8" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="9"
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FFF1F4"
                                                Foreground="#FF4262"
                                                BorderThickness="0"
                                                Content="×"
                                                FontSize="16"
                                                Tag="{Binding}"
                                                Click="BtnRowDelete_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarCloseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="当前分组暂无股票"
                               Foreground="#AAAAAA"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding VisibleStocks.Count, Converter={StaticResource ZeroToVisibleConverter}}" />
                </Grid>
            </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#18FFFFFF"
                CornerRadius="0,0,8,8"
                Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#34C759" Margin="0,0,6,0" />
                <TextBlock Text="数据来源：东方财富 | 仅供参考"
                           Foreground="#50FFFFFF"
                           FontSize="10" />
            </StackPanel>
        </Border>

        <!-- Bottom sheet overlay (covers list + status; independent solid white) -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Visibility="{Binding SelectedStock, Converter={StaticResource NotNullConverter}}"
              Panel.ZIndex="20">
            <!-- Dim mask: click to close -->
            <Border Background="#33000000"
                    PreviewMouseLeftButtonDown="DetailMask_PreviewMouseLeftButtonDown"
                    MouseLeftButtonUp="DetailMask_MouseLeftButtonUp" />

            <!-- Sheet -->
            <Border x:Name="DetailSheetBorder"
                    VerticalAlignment="Bottom"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DoubleOffsetConverter}, ConverterParameter=-36}"
                    Background="#FFFFFFFF"
                    BorderBrush="#E5E5E5"
                    BorderThickness="0,1,0,0"
                    CornerRadius="16,16,0,0"
                    Padding="0"
                    RenderTransformOrigin="0.5,1"
                    MouseLeftButtonDown="DetailSheet_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DetailSheetTransform" Y="0" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="#000000" />
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                <StackPanel Margin="14,8,14,12" DataContext="{Binding SelectedStock}">
                    <!-- Handle + close -->
                    <Grid Margin="0,0,0,6">
                        <Button HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Click="BtnExpandDetail_Click"
                                ToolTip="展开/收起指标">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="12,4">
                                        <TextBlock Text="{Binding DataContext.ExpandHintText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="#888888"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="∨"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="28" Height="28"
                                    FontSize="12"
                                    ToolTip="收起"
                                    Click="BtnCollapseDetail_Click" />
                            <Button Content="✕"
                                    Style="{StaticResource TitleBarCloseButtonStyle}"
                                    Width="28" Height="28"
                                    FontSize="12"
                                    ToolTip="关闭"
                                    Click="BtnCloseDetail_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Name / code / price header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="#1A1A1A"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding CodeNumeric}"
                                           Foreground="#999999"
                                           FontSize="12"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,2" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CurrentPrice, StringFormat={}{0:F2}}"
                                           FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Bottom">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D93025" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" Margin="10,0,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D93025" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding ChangePercent, StringFormat={}{0:+0.00;-0.00;0.00}}" />
                                    <Run Text="%" />
                                </TextBlock>
                                <TextBlock Foreground="#999999" FontSize="12"
                                           VerticalAlignment="Bottom" Margin="12,0,0,3"
                                           Text="{Binding Open, StringFormat=今开 {0:F2}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Stats card: 最高 / 最低 / 成交额 -->
                    <Border Background="#F5F6F8"
                            CornerRadius="10"
                            Padding="8,10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="最高" Foreground="#999999" FontSize="11" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding High, StringFormat={}{0:F2}}" Foreground="#D93025"
                                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="最低" Foreground="#999999" FontSize="11" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Low, StringFormat={}{0:F2}}" Foreground="#1A8C3F"
                                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="成交额" Foreground="#999999" FontSize="11" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TurnoverText}" Foreground="#1A1A1A"
                                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Period pill selector -->
                    <Border Background="#F0F1F3" CornerRadius="16" Padding="3" Margin="0,0,0,8">
                        <UniformGrid Columns="7" Rows="1">
                            <Button Content="分时" Tag="0" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="0">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="5分" Tag="5" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="5">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="15分" Tag="15" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="15">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="30分" Tag="30" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="30">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="60分" Tag="60" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="60">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="日线" Tag="101" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="101">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="周线" Tag="102" Click="KlinePeriod_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PeriodTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlinePeriod}" Value="102">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="Foreground" Value="#1A1A1A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Charts: 分时折线 / K线蜡烛+指标 -->
                    <Grid MinHeight="180">
                        <controls:SparklineControl
                            Points="{Binding IntradayPoints}"
                            AvgPoints="{Binding IntradayAvgPoints}"
                            BaseLine="{Binding YesterdayClose}"
                            IsUp="{Binding IsUp}"
                            ShowLabels="True"
                            VisibleSubCount="{Binding DataContext.ChartSubCount, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2"
                            Visibility="{Binding KlinePeriod, Converter={StaticResource EqualsVisConverter}, ConverterParameter=0}" />
                        <controls:KlineChartControl
                            KlineData="{Binding KlineData}"
                            VisibleSubCount="{Binding DataContext.ChartSubCount, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,2"
                            Visibility="{Binding KlinePeriod, Converter={StaticResource EqualsVisConverter}, ConverterParameter='!0'}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
