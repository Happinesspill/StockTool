<Window x:Class="StockTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StockTool.Controls"
        xmlns:conv="clr-namespace:StockTool.Converters"
        xmlns:views="clr-namespace:StockTool.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="{Binding Topmost}"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Title="盯盘"
        Height="{Binding WindowHeight}"
        Width="{Binding WindowWidth}"
        MinHeight="300"
        MinWidth="400"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged" d:DesignHeight="843" d:DesignWidth="347">

    <Window.Resources>
        <conv:NegativeToBooleanConverter x:Key="NegativeConverter" />
        <conv:FontSizeConverter x:Key="FontSizeConverter" />
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        <conv:OpacityToBrushConverter x:Key="OpacityToBrushConverter" />
        <conv:NotNullToVisibleConverter x:Key="NotNullConverter" />
        <conv:EqualsToVisibilityConverter x:Key="EqualsVisConverter" />
        <conv:DoubleOffsetConverter x:Key="DoubleOffsetConverter" />
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="PeriodTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15CCCCCC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Context Menu Styles -->
        <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FDFFFFFF" />
            <Setter Property="BorderBrush" Value="#E7ECF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#4F5D72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.13"
                                                  Color="#26354A" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Border Padding="12,9,12,8" Name="HeaderBorder">
                                    <StackPanel>
                                        <TextBlock x:Name="HeaderNameText"
                                                   Foreground="#27364A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="HeaderMetaText"
                                                   Foreground="#8FA0B6"
                                                   FontSize="10.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Height="1"
                                        Background="#F0F3F7"
                                        Margin="8,0" />
                                <ItemsPresenter Margin="0,5,0,1" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4F5D72" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Margin="1"
                                    Padding="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Icon"
                                                      ContentSource="Icon"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"
                                                      Margin="2,0,8,0" />
                                    <Path x:Name="Arrow"
                                          Grid.Column="2"
                                          Width="5"
                                          Height="9"
                                          Margin="4,0,2,0"
                                          Data="M0,0 L5,4.5 L0,9 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   HorizontalOffset="2"
                                   VerticalOffset="-6"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right">
                                <Border Background="#FDFFFFFF"
                                        BorderBrush="#E7ECF2"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="8"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="0"
                                                          Opacity="0.13"
                                                          Color="#26354A" />
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6EFF8" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextMenuDeleteItemStyle" TargetType="MenuItem"
               BasedOn="{StaticResource ContextMenuItemStyle}">
            <Setter Property="Foreground" Value="#FF4262" />
        </Style>

        <Style x:Key="ListHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9AA6B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="Foreground" Value="#65758B" />
            <Setter Property="BorderBrush" Value="#E3E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{Binding Opacity, Converter={StaticResource OpacityToBrushConverter}}"
            BorderBrush="{Binding Opacity, Converter={StaticResource OpacityToBrushConverter}, ConverterParameter=CCCCCC}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#33FFFFFF"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="盯盘"
                               Foreground="#555555"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="添加自选"
                                Click="BtnAdd_Click">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="1024" Height="1024">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M469.333333 768c-166.4 0-298.666667-132.266667-298.666666-298.666667s132.266667-298.666667 298.666666-298.666666 298.666667 132.266667 298.666667 298.666666-132.266667 298.666667-298.666667 298.666667z m0-85.333333c119.466667 0 213.333333-93.866667 213.333334-213.333334s-93.866667-213.333333-213.333334-213.333333-213.333333 93.866667-213.333333 213.333333 93.866667 213.333333 213.333333 213.333334z m251.733334 0l119.466666 119.466666-59.733333 59.733334-119.466667-119.466667 59.733334-59.733333z" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="设置"
                                Click="BtnSettings_Click">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="1024" Height="1024">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M469.333333 60.693333a85.333333 85.333333 0 0 1 85.333334 0l326.826666 188.714667a85.333333 85.333333 0 0 1 42.666667 73.898667v377.386666a85.333333 85.333333 0 0 1-42.666667 73.898667L554.666667 963.306667a85.333333 85.333333 0 0 1-85.333334 0L142.506667 774.592a85.333333 85.333333 0 0 1-42.666667-73.898667v-377.386666a85.333333 85.333333 0 0 1 42.666667-73.898667z m42.666667 73.898667L185.173333 323.306667v377.386666L512 889.408l326.826667-188.714667v-377.386666L512 134.592zM512 341.333333a170.666667 170.666667 0 1 1 0 341.333334 170.666667 170.666667 0 0 1 0-341.333334z m0 85.333334a85.333333 85.333333 0 1 0 0 170.666666 85.333333 85.333333 0 0 0 0-170.666666z" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="最小化"
                                Click="BtnHide_Click">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="1024" Height="1024">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M753.066667 458.666667H273.066667c-29.866667 0-53.333333 23.466667-53.333334 53.333333s23.466667 53.333333 53.333334 53.333333h480c29.866667 0 53.333333-23.466667 53.333333-53.333333s-25.6-53.333333-53.333333-53.333333z" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="关闭"
                                Click="BtnClose_Click">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="1024" Height="1024">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M802.6 727.9L591.5 516.8l211.1-211.1c21-21 21-55.4 0-76.5-21-21-55.4-21-76.5 0L515 440.3 303.9 229.2c-21-21-55.4-21-76.5 0-21 21-21 55.4 0 76.5l211.1 211.1-211.1 211.1c-21 21-21 55.4 0 76.5 21 21 55.4 21 76.5 0L515 593.3l211.1 211.1c21 21 55.4 21 76.5 0s21.1-55.4 0-76.5z" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: Indices + Groups + List -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Indices -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Indices}"
                              Margin="6,6,6,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Margin="2,4">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#888888"
                                           FontSize="11"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Price, StringFormat={}{0:F2}}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D93025" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D93025" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Change, StringFormat={}{0:+0.00;-0.00;0.00}, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding ChangePercent, StringFormat={}{0:+0.00;-0.00;0.00}%, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Group tabs -->
                <Grid Grid.Row="1" Margin="8,4,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Groups}"
                             SelectedValue="{Binding SelectedGroupId, Mode=TwoWay}"
                             SelectedValuePath="Id"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="#F5F5F5"
                                                    BorderBrush="#E0E0E0"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,0"
                                                    Height="28">
                                                <TextBlock x:Name="TabText"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="#555555"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EBEBEB" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#4A4A4A" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A4A" />
                                                    <Setter TargetName="TabText" Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Width="20" Height="20"
                                ToolTip="管理分组"
                                Click="BtnManageGroups_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="1024" Height="1024">
                                    <Path Fill="#555555"
                                          Data="M474.58679343 587.16868738c-11.45302241 0-22.90604486-4.37057868-31.6472022-13.11173601-17.48231469-17.48231469-17.48231469-45.83841849 0-63.29440437l487.24053555-487.24053552c17.48231469-17.48231469 45.81208967-17.48231469 63.29440431 0 17.48231469 17.48231469 17.48231469 45.83841849 0 63.29440441L506.23399561 574.05695137a44.61676276 44.61676276 0 0 1-31.64720218 13.11173601z" />
                                    <Path Fill="#555555"
                                          Data="M904.16728498 1017.19676833h-781.96497912c-62.68884228 0-113.68770304-50.99886074-113.68770305-113.71403181v-781.96497913c0-62.71517108 50.99886074-113.71403182 113.66137425-113.71403185l457.51533479 0.0263288c24.72273117 0 44.75893818 20.03620706 44.75893819 44.7589382s-20.03620706 44.75893818-44.75893819 44.7589382l-457.51533479-0.02632877c-13.2960375 0-24.14349786 10.84746035-24.14349785 24.16982661v781.96497915c0 13.32236631 10.84746035 24.1698266 24.16982665 24.16982664h781.96497912c13.32236631 0 24.1698266-10.84746035 24.16982668-24.16982664V403.42008173c0-24.72273117 20.06253583-44.75893818 44.75893815-44.75893828 24.72273117 0 44.75893818 20.03620706 44.7589382 44.75893828V903.50906532c0 62.68884228-50.99886074 113.68770304-113.68770303 113.68770301z" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Holding summary：持仓/基金页显示总持仓、总浮盈、今日盈亏；其他分组隐藏 -->
                <Border Grid.Row="2" Margin="10,6,10,3" Background="#F6F8FB" BorderBrush="#E9EDF3" BorderThickness="1" CornerRadius="7" Padding="8,6"
                        Visibility="{Binding ShowHoldingSummary, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding HoldingMarketValueLabel}" Foreground="#9AA6B8" FontSize="10"/>
                            <TextBlock Text="{Binding HoldingMarketValueText}" Foreground="#4F5D72" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding ShowHoldingSummaryDetails, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="总浮盈" Foreground="#9AA6B8" FontSize="10"/>
                            <TextBlock Text="{Binding HoldingProfitTotalText}" Foreground="#D93025" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding ShowHoldingSummaryDetails, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel.ToolTip>
                                <ToolTip>
                                    <ItemsControl ItemsSource="{Binding HoldingTodayProfitDetails}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="180" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ChangeText}"
                                                               FontSize="12"
                                                               Margin="20,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ToolTip>
                            </StackPanel.ToolTip>
                            <TextBlock Text="今日盈亏" Foreground="#9AA6B8" FontSize="10"/>
                            <TextBlock Text="{Binding HoldingTodayProfitText}" Foreground="#D93025" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="◉" Style="{StaticResource TitleBarButtonStyle}" ToolTip="预警设置" Click="BtnAlertSettings_Click"
                                Visibility="{Binding ShowHoldingSummaryDetails, Converter={StaticResource BoolToVisConverter}}" />
                    </Grid>
                </Border>

                <!-- Column header -->
                <ScrollViewer x:Name="HeaderScroll"
                              Grid.Row="3"
                              Height="22"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,4,0,2">
                    <Grid x:Name="HeaderGrid" MinWidth="320" Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding DataContext.NameColumnWidth, ElementName=HeaderScroll}" />
                            <ColumnDefinition Width="{Binding DataContext.ShowHoldingAmountColumn, ElementName=HeaderScroll, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=80}" />
                            <ColumnDefinition Width="{Binding DataContext.ShowHoldingColumn, ElementName=HeaderScroll, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=80}" />
                            <ColumnDefinition Width="{Binding DataContext.ShowTrendColumn, ElementName=HeaderScroll, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=*}" />
                            <ColumnDefinition Width="96" />

                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称"
                                   Foreground="#9AA6B8"
                                   FontSize="11"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <Button Grid.Column="1"
                                Tag="holdingAmount"
                                Style="{StaticResource ListHeaderButtonStyle}"
                                HorizontalContentAlignment="Right"
                                Margin="0,0,8,0"
                                Click="BtnSortColumn_Click"
                                Visibility="{Binding ShowHoldingAmountColumn, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="持有金额" />
                                <TextBlock Text="{Binding HoldingAmountSortArrow}" Width="10" Margin="2,0,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Tag="profit"
                                Style="{StaticResource ListHeaderButtonStyle}"
                                HorizontalContentAlignment="Right"
                                Margin="0,0,8,0"
                                Click="BtnSortColumn_Click"
                                Visibility="{Binding ShowHoldingColumn, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding HoldingProfitColumnHeader}" />
                                <TextBlock Text="{Binding ProfitSortArrow}" Width="10" Margin="2,0,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="3" Text="趋势" Foreground="#9AA6B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowTrendColumn, Converter={StaticResource BoolToVisConverter}}" />
                        <Button Grid.Column="4" Tag="change" Style="{StaticResource ListHeaderButtonStyle}" HorizontalContentAlignment="Right" Margin="0,0,10,0" Click="BtnSortColumn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PriceColumnHeader}" />
                                <TextBlock Text="{Binding ChangeSortArrow}" Width="10" Margin="2,0,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </ScrollViewer>

                <!-- Stock list -->
                <Grid Grid.Row="4">
                    <ScrollViewer x:Name="ListScroll"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="ListScroll_ScrollChanged">
                        <ItemsControl x:Name="StockList"
                                      ItemsSource="{Binding VisibleStocks}"
                                      MinWidth="320"
                                      AllowDrop="True"
                                      PreviewMouseLeftButtonDown="StockList_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="StockList_PreviewMouseMove"
                                      Drop="StockList_Drop"
                                      GiveFeedback="StockList_GiveFeedback"
                                      DragOver="StockList_DragOver">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="52"
                                        BorderBrush="#10000000"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="StockItem_Click">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource ContextMenuStyle}"
                                                     Opened="ContextMenu_Opened">
                                                <MenuItem Header="置顶"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_MoveTop">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M8,13.5 L8,4.5 M4.8,7.7 L8,4.5 L11.2,7.7 M4,14.5 L12,14.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="置底"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_MoveBottom">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M8,2.5 L8,11.5 M4.8,8.3 L8,11.5 L11.2,8.3 M4,1.5 L12,1.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="设置持仓"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_SetHolding">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M3,5.5 L13,5.5 A1.5,1.5 0 0 1 14.5,7 L14.5,12 A1.5,1.5 0 0 1 13,13.5 L3,13.5 A1.5,1.5 0 0 1 1.5,12 L1.5,4 A1.5,1.5 0 0 1 3,2.5 L10.5,2.5 A1.5,1.5 0 0 1 12,4 L12,5.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                                <Path Data="M11.2,9.5 L14.5,9.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                                <Ellipse Canvas.Left="10.3"
                                                                     Canvas.Top="8.65"
                                                                     Width="1.7"
                                                                     Height="1.7"
                                                                     Fill="#65758B" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="MenuSetDca"
                                                      Header="设置定投"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_SetDca">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M3,8 A5,5 0 1 0 8,3 M8,3 L8,8 L11,8"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="重命名"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_Rename">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M10.5,3.2 L12.8,5.5 L6.2,12.1 L3.5,12.8 L4.2,10.1 Z M9.3,4.4 L11.6,6.7"
                                                                      Stroke="#65758B"
                                                                      StrokeThickness="1.35"
                                                                      Fill="Transparent"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="删除股票"
                                                      Style="{StaticResource ContextMenuDeleteItemStyle}"
                                                      Click="ContextMenu_Delete">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M3.5,4.5 L12.5,4.5 M6.5,2.5 L9.5,2.5 M5,4.5 L5.7,13.3 A1.2,1.2 0 0 0 6.9,14.5 L9.1,14.5 A1.2,1.2 0 0 0 10.3,13.3 L11,4.5 M6.8,7 L6.8,12 M9.2,7 L9.2,12"
                                                                  Stroke="#FF4262"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="设置预警"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_SetAlert">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="◉" Foreground="#65758B" FontSize="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Margin="8,4" />
                                                <MenuItem x:Name="RemoveFromGroupMenuItem"
                                                      Header="从当前分组移出"
                                                      Style="{StaticResource ContextMenuItemStyle}"
                                                      Click="ContextMenu_RemoveFromGroup">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M2,5 A1.5,1.5 0 0 1 3.5,3.5 L6.3,3.5 L7.8,5 L12.5,5 A1.5,1.5 0 0 1 14,6.5 L14,12.5 A1.5,1.5 0 0 1 12.5,14 L3.5,14 A1.5,1.5 0 0 1 2,12.5 Z"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                                <Path Data="M6.5,9.5 L11.5,9.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="GroupSubMenu"
                                                      Header="加入其他分组"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                    <MenuItem.Icon>
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="16" Height="16">
                                                                <Path Data="M2,5 A1.5,1.5 0 0 1 3.5,3.5 L6.3,3.5 L7.8,5 L12.5,5 A1.5,1.5 0 0 1 14,6.5 L14,12.5 A1.5,1.5 0 0 1 12.5,14 L3.5,14 A1.5,1.5 0 0 1 2,12.5 Z"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  Fill="Transparent"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                                <Path Data="M8,9.5 L12,9.5 M10,7.5 L10,11.5"
                                                                  Stroke="#65758B"
                                                                  StrokeThickness="1.35"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding DataContext.NameColumnWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <ColumnDefinition Width="{Binding DataContext.ShowHoldingAmountColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=80}" />
                                                <ColumnDefinition Width="{Binding DataContext.ShowHoldingColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=80}" />
                                                <ColumnDefinition Width="{Binding DataContext.ShowTrendColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=*}" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="0" />


                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,4,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="#1A1A1A"
                                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}}"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                            Visibility="{Binding DataContext.IsHoldingGroupSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsVisConverter}, ConverterParameter=False}">
                                                    <Border CornerRadius="3"
                                                        Background="#3050A0FF"
                                                        Padding="3,1"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ShowMarketTag, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding Market}"
                                                               Foreground="#80D0FF"
                                                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=-5}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding CodeNumeric}"
                                                           Foreground="#888888"
                                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=-3}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding HoldingListMarketValueText}"
                                                       Foreground="#D93025"
                                                       FontWeight="Bold"
                                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontSizeConverter}, ConverterParameter=-3}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding DataContext.IsHoldingGroupSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding HoldingAmountText}"
                                                       Foreground="#4F5D72"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding DataContext.ShowHoldingAmountColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />

                                            <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding DataContext.ShowHoldingColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding HoldingProfit, StringFormat={}{0:+0.##;-0.##;0}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#AAB4C3" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasHolding}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D93025" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HoldingProfit, Converter={StaticResource NegativeConverter}}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding HoldingProfitPercent, StringFormat={}{0:+0.00;-0.00;0.00}%}"
                                                       Foreground="#8FA0B6"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding PriceText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#1A1A1A"
                                                       Visibility="{Binding IsFund, Converter={StaticResource EqualsVisConverter}, ConverterParameter=False}" />
                                                <TextBlock Text="{Binding TodayEstimateProfitText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsFund, Converter={StaticResource EqualsVisConverter}, ConverterParameter=True}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#AAB4C3" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasHolding}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D93025" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TodayHoldingProfit, Converter={StaticResource NegativeConverter}}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasFundValuation}" Value="False">
                                                                    <Setter Property="Foreground" Value="#AAB4C3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ChangePercentText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#D93025" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                                         Value="True">
                                                                    <Setter Property="Foreground" Value="#1A8C3F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChangePercent}" Value="0">
                                                                    <Setter Property="Foreground" Value="#888888" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChangePercentText}" Value="--">
                                                                    <Setter Property="Foreground" Value="#888888" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <controls:SparklineControl Grid.Column="3"
                                                                    Points="{Binding IntradayPoints}"
                                                                    BaseLine="{Binding YesterdayClose}"
                                                                    IsUp="{Binding IsUp}"
                                                                    Margin="4,4"
                                                                    Visibility="{Binding DataContext.ShowTrendColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" />

                                            <TextBlock Grid.Column="5" Text="{Binding TurnoverText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="6" Text="{Binding TurnoverRateText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="7" Text="{Binding SpeedText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#AAB4C3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=Speed, Converter={StaticResource NegativeConverter}}" Value="True">
                                                                <Setter Property="Foreground" Value="#1A8C3F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Speed}" Value="0">
                                                                <Setter Property="Foreground" Value="#AAB4C3" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSpeedUp}" Value="True">
                                                                <Setter Property="Foreground" Value="#D93025" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="8" Text="{Binding VolumeRatioText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="9" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding FloatMarketValueText}" Foreground="#65758B" FontSize="11" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding TotalMarketValueText}" Foreground="#9AA6B8" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="10"
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FFF1F4"
                                                Foreground="#FF4262"
                                                BorderThickness="0"
                                                Content="×"
                                                FontSize="16"
                                                Tag="{Binding}"
                                                Click="BtnRowDelete_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarCloseButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding EmptyListHint}"
                               Foreground="#AAAAAA"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding VisibleStocks.Count, Converter={StaticResource ZeroToVisibleConverter}}" />
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2"
                Background="#18FFFFFF"
                CornerRadius="0,0,8,8"
                Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#34C759" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusSourceText}"
                           Foreground="#50FFFFFF"
                           FontSize="10" />
                </StackPanel>
            </Border>

            <!-- Bottom sheet overlay；设计器中默认收起，便于编辑主页面 -->
            <views:StockDetailSheet x:Name="DetailSheet"
                                Grid.Row="1" Grid.RowSpan="2"
                                d:Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
