<Window x:Class="StockTool.Views.ManageGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StockTool.Controls"
        xmlns:conv="clr-namespace:StockTool.Converters"
        xmlns:vm="clr-namespace:StockTool.ViewModels"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="640" Height="920"
        MinWidth="520" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="False"
        Title="管理分组"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:NegativeToBooleanConverter x:Key="NegativeConverter" />
        <conv:GrayLevelBorderConverter x:Key="GrayLevelBorderConverter" />
        <Style x:Key="GroupActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupDeleteButtonStyle" TargetType="Button"
               BasedOn="{StaticResource GroupActionButtonStyle}">
            <Setter Property="Foreground" Value="#FF453A" />
        </Style>
        <Style x:Key="AddGroupButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="新建分组" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#F0F0F0"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Text="+"
                                       FontSize="18"
                                       Foreground="#555555"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TinyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F5FFFFFF"
            BorderBrush="#D0CCCCCC"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,2,0">
                <StackPanel>
                    <!-- 首页指数设置 -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="首页指数设置"
                                   Foreground="#666666"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <ListBox x:Name="IndexCardList"
                                 ItemsSource="{Binding SelectedHomeIndices}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="IndexCardList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="IndexCardList_PreviewMouseMove"
                                 DragOver="IndexCardList_DragOver"
                                 Drop="IndexCardList_Drop"
                                 GiveFeedback="IndexCardList_GiveFeedback">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F0F0"
                                            CornerRadius="8"
                                            Padding="8,10"
                                            Margin="4,6"
                                            MinHeight="64">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14"
                                                              ShadowDepth="2"
                                                              Direction="270"
                                                              Color="#000000"
                                                              Opacity="0.14" />
                                        </Border.Effect>
                                        <Grid>
                                            <Button Content="✕"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Width="18" Height="18"
                                                    FontSize="10"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#999999"
                                                    Cursor="Hand"
                                                    Click="BtnRemoveIndex_Click"
                                                    Tag="{Binding Code}" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#1A1A1A"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" />
                                                <Border Background="White"
                                                        CornerRadius="8"
                                                        Padding="6,2"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayCode}"
                                                               Foreground="#888888"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Height="1" Background="#E5E5E5" Margin="0,12,0,10" />

                        <ItemsControl ItemsSource="{Binding IndexOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,6"
                                            Cursor="Hand"
                                            Click="BtnToggleIndex_Click"
                                            Tag="{Binding Code}"
                                            ToolTip="{Binding DisplayCode}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="White"
                                                        BorderBrush="#CCCCCC"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="10,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CheckMark}"
                                                                   Foreground="#666666"
                                                                   FontSize="11"
                                                                   Margin="0,0,4,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#444444"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#AAAAAA" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 管理分组标题 + 新建 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="管理分组"
                                   Foreground="#1A1A1A"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Grid.Column="1" Width="50"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AddGroupButtonStyle}"
                                Click="BtnAddGroup_Click" />
                    </Grid>

                    <TextBlock Text="拖拽可调顺序，右键重命名/删除"
                               Foreground="#888888"
                               FontSize="11"
                               Margin="0,0,0,8" />

                    <ListBox x:Name="GroupList"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="GroupList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="GroupList_PreviewMouseMove"
                             Drop="GroupList_Drop"
                             GiveFeedback="GroupList_GiveFeedback"
                             DragOver="GroupList_DragOver">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="#F0F0F0"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,0"
                                                    Height="28"
                                                    ToolTip="拖拽排序；右键重命名/删除">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="重命名"
                                                                  Click="MenuRenameGroup_Click" />
                                                        <MenuItem Header="删除"
                                                                  Foreground="#FF453A"
                                                                  Click="MenuDeleteGroup_Click" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <TextBlock x:Name="TabText"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="#555555"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E4E4E4" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#B34A4A4A" />
                                                    <Setter TargetName="TabText" Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Height="1" Background="#E5E5E5" Margin="0,8,0,14" />

                    <!-- 电脑任务栏设置 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="电脑任务栏设置"
                                   Foreground="#1A1A1A"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Left"
                                Content="+ 添加股票"
                                Style="{StaticResource GroupActionButtonStyle}"
                                Height="28"
                                MinWidth="84"
                                Click="BtnAddTaskbarStock_Click"
                                ToolTip="添加股票到任务栏，可选屏幕 1/2" />
                    </Grid>

                    <TextBlock Text="透明背景贴合任务栏本色，可多股并排，拖拽可调顺序"
                               Foreground="#888888"
                               FontSize="11"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />

                    <ListBox x:Name="TaskbarList"
                             ItemsSource="{Binding TaskbarStocks}"
                             BorderThickness="0"
                             Background="Transparent"
                             MinHeight="40"
                             MaxHeight="180"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="TaskbarList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskbarList_PreviewMouseMove"
                             Drop="TaskbarList_Drop"
                             GiveFeedback="TaskbarList_GiveFeedback"
                             DragOver="TaskbarList_DragOver">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="#F0F0F0"
                                                    CornerRadius="10"
                                                    Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Stock.DisplayName}"
                                                   Foreground="#1A1A1A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Stock.CodeNumeric}"
                                                   Foreground="#888888"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Width="78"
                                              Height="26"
                                              VerticalAlignment="Center"
                                              Margin="8,0,6,0"
                                              ItemsSource="{Binding DataContext.AvailableScreens, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Screen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemStringFormat="屏幕{0}"
                                              SelectionChanged="TaskbarScreen_SelectionChanged"
                                              Tag="{Binding}" />
                                    <Button Grid.Column="2"
                                            Content="↑"
                                            Style="{StaticResource TinyIconButtonStyle}"
                                            Margin="0,0,4,0"
                                            Click="BtnTaskbarMoveUp_Click"
                                            Tag="{Binding}"
                                            ToolTip="上移" />
                                    <Button Grid.Column="3"
                                            Content="↓"
                                            Style="{StaticResource TinyIconButtonStyle}"
                                            Margin="0,0,4,0"
                                            Click="BtnTaskbarMoveDown_Click"
                                            Tag="{Binding}"
                                            ToolTip="下移" />
                                    <Button Grid.Column="4"
                                            Content="删除"
                                            Style="{StaticResource GroupDeleteButtonStyle}"
                                            Click="BtnRemoveTaskbar_Click"
                                            Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="TxtTaskbarEmpty"
                               Text="尚未添加任务栏股票"
                               Foreground="#AAAAAA"
                               FontSize="12"
                               Margin="4,0,0,8"
                               Visibility="Collapsed" />

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分时图长度"
                                   Foreground="#555555"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Slider Grid.Column="1"
                                Minimum="{x:Static vm:MainViewModel.TaskbarSparklineWidthMin}"
                                Maximum="{x:Static vm:MainViewModel.TaskbarSparklineWidthMax}"
                                Value="{Binding TaskbarSparklineWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TaskbarSparklineWidthText}"
                                   Foreground="#666666"
                                   FontSize="12"
                                   Width="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 与系统时钟的间距 -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="与时间距离"
                                   Foreground="#555555"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   ToolTip="任务栏股票与后面系统时间的间距" />
                        <Slider Grid.Column="1"
                                Minimum="{x:Static vm:MainViewModel.TaskbarClockGapMin}"
                                Maximum="{x:Static vm:MainViewModel.TaskbarClockGapMax}"
                                Value="{Binding TaskbarClockGap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TaskbarClockGapText}"
                                   Foreground="#666666"
                                   FontSize="12"
                                   Width="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 上下位置微调 -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="上下位置"
                                   Foreground="#555555"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   ToolTip="正值下移，负值上移，用于与任务栏图标对齐" />
                        <Slider Grid.Column="1"
                                Minimum="{x:Static vm:MainViewModel.TaskbarVerticalOffsetMin}"
                                Maximum="{x:Static vm:MainViewModel.TaskbarVerticalOffsetMax}"
                                Value="{Binding TaskbarVerticalOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TaskbarVerticalOffsetText}"
                                   Foreground="#666666"
                                   FontSize="12"
                                   Width="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称价格颜色"
                                   Foreground="#555555"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Width="36" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="浅灰"
                                    Tag="1" Click="BtnTaskbarGray_Click" Background="#F0F0F0"
                                    BorderBrush="{Binding TaskbarTextGrayLevel, Converter={StaticResource GrayLevelBorderConverter}, ConverterParameter=1}"
                                    BorderThickness="2" />
                            <Button Width="36" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="次浅"
                                    Tag="2" Click="BtnTaskbarGray_Click" Background="#C8C8C8"
                                    BorderBrush="{Binding TaskbarTextGrayLevel, Converter={StaticResource GrayLevelBorderConverter}, ConverterParameter=2}"
                                    BorderThickness="2" />
                            <Button Width="36" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="中灰"
                                    Tag="3" Click="BtnTaskbarGray_Click" Background="#969696"
                                    BorderBrush="{Binding TaskbarTextGrayLevel, Converter={StaticResource GrayLevelBorderConverter}, ConverterParameter=3}"
                                    BorderThickness="2" />
                            <Button Width="36" Height="28" Margin="0,0,8,0" Cursor="Hand" ToolTip="深灰"
                                    Tag="4" Click="BtnTaskbarGray_Click" Background="#646464"
                                    BorderBrush="{Binding TaskbarTextGrayLevel, Converter={StaticResource GrayLevelBorderConverter}, ConverterParameter=4}"
                                    BorderThickness="2" />
                        </StackPanel>
                    </Grid>

                    <!-- 浏览效果 -->
                    <TextBlock Text="浏览效果"
                               Foreground="#1A1A1A"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,10,0,8" />
                    <TextBlock Text="示意任务栏透明贴合效果（长度与颜色可实时预览）"
                               Foreground="#888888"
                               FontSize="11"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />

                    <Border CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,4"
                            ClipToBounds="True">
                        <Border.Background>
                            <SolidColorBrush Color="#2B2B2B" />
                        </Border.Background>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TaskbarStocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,2,10,2" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Stock.DisplayName}"
                                                               FontSize="12"
                                                               FontWeight="Normal"
                                                               FontFamily="Segoe UI, Microsoft YaHei UI"
                                                               Foreground="{Binding DataContext.TaskbarTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               MaxWidth="108"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <TextBlock Text="{Binding Stock.TaskbarPriceText}"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   FontFamily="Segoe UI, Microsoft YaHei UI"
                                                                   Foreground="{Binding DataContext.TaskbarTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   VerticalAlignment="Bottom" />
                                                        <TextBlock Text="{Binding Stock.ChangePercentText}"
                                                                   FontSize="11"
                                                                   FontWeight="Normal"
                                                                   FontFamily="Segoe UI, Microsoft YaHei UI"
                                                                   Margin="4,0,0,0"
                                                                   VerticalAlignment="Bottom">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#D93025" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Stock.ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="#1A8C3F" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Stock.ChangePercent}" Value="0">
                                                                            <Setter Property="Foreground" Value="#666666" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <controls:SparklineControl Grid.Column="1"
                                                                           Points="{Binding Stock.IntradayPoints}"
                                                                           BaseLine="{Binding Stock.YesterdayClose}"
                                                                           IsUp="{Binding Stock.IsUp}"
                                                                           ExpectedCount="0"
                                                                           Width="{Binding DataContext.TaskbarSparklineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Height="28"
                                                                           Margin="2,0"
                                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="保存"
                        Height="40"
                        Background="#3B7CFF"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2"
                        Content="取消"
                        Height="40"
                        Background="#F0F0F0"
                        Foreground="#1A1A1A"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 右下角拖拽调整窗口大小 -->
            <Thumb Grid.Row="0" Grid.RowSpan="2"
                   x:Name="ResizeThumb"
                   Width="18" Height="18"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-4,-4"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta"
                   ToolTip="拖拽调整大小">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Canvas Background="Transparent" Width="18" Height="18">
                            <Path Stroke="#AA888888"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 10,16 L 16,10 M 13,16 L 16,13" />
                        </Canvas>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
