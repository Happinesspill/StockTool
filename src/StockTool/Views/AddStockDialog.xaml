<Window x:Class="StockTool.Views.AddStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        Title="添加自选"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#F5FFFFFF"
            BorderBrush="#D0CCCCCC"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="添加自选"
                       Foreground="#1A1A1A"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <!-- Search Bar -->
            <Border x:Name="SearchBar" Grid.Row="1"
                    Background="#F0F0F0"
                    CornerRadius="20"
                    Padding="10,4"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔍"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"
                               Opacity="0.45" />

                    <TextBox x:Name="TxtSearch"
                             Grid.Column="1"
                             Background="Transparent"
                             Foreground="#1A1A1A"
                             CaretBrush="#1A1A1A"
                             FontSize="14"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             DataObject.Pasting="TxtSearch_Pasting"
                             ToolTip="输入股票名称或代码搜索" />

                    <Button x:Name="BtnClear"
                            Grid.Column="2"
                            Content="✕"
                            Width="24" Height="24"
                            FontSize="11"
                            Background="Transparent"
                            Foreground="#999999"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnClear_Click"
                            Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Results / Import List -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    CornerRadius="8">
                <Grid>
                    <!-- Search results -->
                    <ListBox x:Name="LstResults"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemsSource="{Binding}"
                             Visibility="Collapsed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="0"
                                                    Margin="0,1">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E6F0FA" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B0D0F0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10,0,10" Cursor="Hand"
                                        MouseLeftButtonDown="ResultItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#1A1A1A"
                                                       FontSize="15"
                                                       FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Code}"
                                                           Foreground="#999999"
                                                           FontSize="11" />
                                                <TextBlock Text="  "
                                                           Foreground="#AAAAAA"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding Market}"
                                                           Foreground="#999999"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="+"
                                                Width="34" Height="34"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="#1A1A1A"
                                                Background="#E8E8E8"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="BtnAddResult_Click"
                                                Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="17">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Holding import preview -->
                    <ListBox x:Name="LstImport"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="0" Margin="0,2">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F7F7" CornerRadius="8" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  IsEnabled="{Binding CanMatch}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#1A1A1A"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Foreground="#888888" FontSize="11" Margin="0,2,0,0">
                                                <Run Text="{Binding Code, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Market, Mode=OneWay}" />
                                                <Run Text="  数量 " />
                                                <Run Text="{Binding SharesText, Mode=OneWay}" />
                                                <Run Text="  成本 " />
                                                <Run Text="{Binding CostText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty / Searching state -->
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="输入股票名称或代码搜索&#x0a;或 Ctrl+V 粘贴持仓截图"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="BtnBack"
                        Content="返回"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="72"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="BtnBack_Click" />
                <Button x:Name="BtnSync"
                        Content="同步持仓"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="88"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="BtnSync_Click" />
                <Button Content="取消"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="80"
                        Click="BtnCancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
