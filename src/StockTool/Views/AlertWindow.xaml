<Window x:Class="StockTool.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="560"
        Height="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="False"
        Title="预警设置"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="AlertActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertDeleteButtonStyle" TargetType="Button"
               BasedOn="{StaticResource AlertActionButtonStyle}">
            <Setter Property="Foreground" Value="#FF453A" />
        </Style>
    </Window.Resources>

    <Border Background="#F5FFFFFF"
            BorderBrush="#D0CCCCCC"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="预警设置"
                           Foreground="#1A1A1A"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding AlertCount, StringFormat=已启用 {0} 条}"
                           Foreground="#888888"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="右键股票行可新增预警；命中价格当天提醒一次，可在下方停用或删除"
                       Foreground="#888888"
                       FontSize="11"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap" />

            <!-- 预警列表 -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,2,0">
                <ItemsControl ItemsSource="{Binding AlertItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F0F0F0"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StockName}"
                                                   Foreground="#1A1A1A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CodeText}"
                                                   Foreground="#888888"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="10,0,10,0">
                                        <TextBlock Text="{Binding ConditionText}"
                                                   Foreground="#555555"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CurrentValueText}"
                                                   Foreground="#888888"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            CornerRadius="8"
                                            Padding="8,3"
                                            Margin="0,0,10,0"
                                            Background="#FFFFFF"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTriggeredToday}" Value="True">
                                                            <Setter Property="Foreground" Value="#E65100" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <CheckBox Content="启用"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Foreground="#555555"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <Button Content="删除"
                                                Style="{StaticResource AlertDeleteButtonStyle}"
                                                Click="BtnDeleteAlert_Click"
                                                Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="TxtAlertEmpty"
                       Grid.Row="2"
                       Text="尚未添加任何预警，可在股票行右键选择「设置预警」"
                       Foreground="#AAAAAA"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,20,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- 底部按钮 -->
            <Button Grid.Row="3"
                    Content="关闭"
                    Height="36"
                    Margin="0,12,0,0"
                    Background="#F0F0F0"
                    Foreground="#1A1A1A"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
