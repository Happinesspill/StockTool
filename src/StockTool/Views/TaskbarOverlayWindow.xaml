<Window x:Class="StockTool.Views.TaskbarOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StockTool.Controls"
        xmlns:conv="clr-namespace:StockTool.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Title="任务栏行情">
    <Window.Resources>
        <conv:NegativeToBooleanConverter x:Key="NegativeConverter" />
        <DataTemplate x:Key="TickerTemplate">
            <Border Padding="8,2,10,2" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Stock.DisplayName}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{Binding PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="108" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="{Binding Stock.TaskbarPriceText}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{Binding PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding Stock.ChangePercentText}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Bottom">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D93025" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stock.ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                         Value="True">
                                                <Setter Property="Foreground" Value="#1A8C3F" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock.ChangePercent}" Value="0">
                                                <Setter Property="Foreground" Value="#666666" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <controls:SparklineControl Grid.Column="1"
                                               Points="{Binding Stock.IntradayPoints}"
                                               BaseLine="{Binding Stock.YesterdayClose}"
                                               IsUp="{Binding Stock.IsUp}"
                                               ExpectedCount="{Binding Stock.IntradaySlotCount}"
                                               Width="52"
                                               Height="28"
                                               Margin="2,0"
                                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 背景全透明，透出任务栏本色 -->
    <ItemsControl x:Name="TickerList"
                  Background="Transparent"
                  ItemTemplate="{StaticResource TickerTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</Window>
