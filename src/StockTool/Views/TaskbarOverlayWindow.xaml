<Window x:Class="StockTool.Views.TaskbarOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StockTool.Controls"
        xmlns:conv="clr-namespace:StockTool.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Title="任务栏行情"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <conv:NegativeToBooleanConverter x:Key="NegativeConverter" />
        <DataTemplate x:Key="TickerTemplate">
            <!-- alpha=1：分层窗 Transparent(alpha=0) 会点穿到任务栏，导致叠层被盖住“消失” -->
            <Border Padding="6,0,8,0"
                    Background="#01000000"
                    Cursor="Hand"
                    ToolTip="双击打开并定位到该股票"
                    MouseLeftButtonDown="Ticker_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center" Height="36"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="{Binding Stock.DisplayName}"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="{Binding PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="100"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="13" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Stock.TaskbarPriceText}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Foreground="{Binding PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       VerticalAlignment="Bottom"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="13" />
                            <TextBlock Text="{Binding Stock.ChangePercentText}"
                                       FontSize="10"
                                       FontWeight="Normal"
                                       Margin="3,0,0,0"
                                       VerticalAlignment="Bottom"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D93025" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stock.ChangePercent, Converter={StaticResource NegativeConverter}}"
                                                         Value="True">
                                                <Setter Property="Foreground" Value="#1A8C3F" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock.ChangePercent}" Value="0">
                                                <Setter Property="Foreground" Value="#666666" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- ExpectedCount=0：已有分时点拉满宽度；高度固定保证上下不被裁切 -->
                    <controls:SparklineControl Grid.Column="1"
                                               Points="{Binding Stock.IntradayPoints}"
                                               BaseLine="{Binding Stock.YesterdayClose}"
                                               IsUp="{Binding Stock.IsUp}"
                                               ExpectedCount="0"
                                               Width="{Binding SparklineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Height="30"
                                               Margin="2,0"
                                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- alpha=1 几乎全透明，但仍可命中，避免点穿任务栏 -->
    <ItemsControl x:Name="TickerList"
                  Background="#01000000"
                  ItemTemplate="{StaticResource TickerTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</Window>
