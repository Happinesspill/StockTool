            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="保存"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Click="BtnSave_Click"
                        />
                <Button Grid.Column="1"
                        Content="取消"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="BtnCancel_Click" 
                        Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
