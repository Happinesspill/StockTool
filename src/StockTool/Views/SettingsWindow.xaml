<Window x:Class="StockTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Title="设置"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#CCCCCCCC" />
            <Setter Property="CaretBrush" Value="#1A1A1A" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#CCCCCCCC" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="#888888"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,4,0" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        BorderBrush="#CCCCCCCC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F5FFFFFF"
            BorderBrush="#D0CCCCCC"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">

        <StackPanel Width="340">
            <TextBlock Text="设置"
                       Foreground="#1A1A1A"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18" />

            <!-- Opacity -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="透明度"
                           Foreground="#555555"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        x:Name="SldOpacity"
                        Minimum="0" Maximum="100"
                        ValueChanged="SldOpacity_ValueChanged" />
                <TextBlock Grid.Column="2"
                           x:Name="TxtOpacity"
                           Foreground="#888888"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Font Size -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="字号"
                           Foreground="#555555"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          x:Name="CmbFontSize"
                          Style="{StaticResource RoundedComboBoxStyle}"
                          HorizontalAlignment="Left"
                          Width="100" />
            </Grid>

            <!-- Refresh Interval -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="刷新间隔"
                           Foreground="#555555"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          x:Name="CmbInterval"
                          Style="{StaticResource RoundedComboBoxStyle}"
                          HorizontalAlignment="Left"
                          Width="100" />
            </Grid>

            <!-- Hotkey -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="全局热键"
                           Foreground="#555555"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         x:Name="TxtHotkey"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         IsReadOnly="True"
                         PreviewKeyDown="TxtHotkey_PreviewKeyDown" />
                <Button Grid.Column="2"
                        Content="录制"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="50"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="BtnRecord_Click" />
            </Grid>

            <!-- Topmost -->
            <CheckBox x:Name="ChkTopmost"
                      Content="窗口置顶"
                      Foreground="#555555"
                      FontSize="13"
                      Margin="0,0,0,14" />

            <!-- Show Market Tag -->
            <CheckBox x:Name="ChkShowMarketTag"
                      Content="显示市场标签（沪A/深A/港股/ETF）"
                      Foreground="#555555"
                      FontSize="13"
                      Margin="0,0,0,14" />

            <!-- 首页指数排序区块已从设置页移除（保留原代码备查）
            <TextBlock Text="首页指数排序"
                       Foreground="#27364A"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding SelectedHomeIndices}"
                          Margin="0,0,0,18">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F6F8FB"
                                BorderBrush="#E7ECF2"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,7"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#27364A"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayCode}"
                                               Foreground="#8FA0B6"
                                               FontSize="10"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="↑"
                                            Width="26"
                                            Height="24"
                                            Tag="{Binding Code}"
                                            Style="{StaticResource DialogButtonStyle}"
                                            Click="BtnMoveIndexUp_Click" />
                                    <Button Content="↓"
